{
  "mcpServers": {
    "codex": {
      "command": "python3",
      "args": [
        "${PLUGIN_ROOT}/scripts/codex_mcp_server.py",
        "--data-dir",
        "${PLUGIN_DATA}"
      ],
      "timeoutSeconds": 900,
      "tools": {
        "codex_status": {
          "eager": true,
          "background": "off"
        },
        "codex_plan": {
          "eager": false
        },
        "codex_run": {
          "eager": false
        },
        "codex_review": {
          "eager": false
        },
        "codex_poll": {
          "eager": false
        }
      }
    }
  }
}
